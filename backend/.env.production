# ============================================================
# PRODUCTION ENVIRONMENT — fill in values from Hostinger hPanel
# Rename this file to .env on the server (or paste into hPanel env vars)
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# Database — get these from Supabase > Settings > Database > Connection parameters
# Host looks like: db.xxxxxxxxxxxx.supabase.co
DB_HOST=db.PASTE_YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=PASTE_YOUR_SUPABASE_DATABASE_PASSWORD_HERE

# JWT — use a long random string (min 32 chars), NEVER reuse your local secret
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_HERE_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Email — use a Gmail App Password (not your real password)
# How to get App Password: myaccount.google.com > Security > 2FA > App passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=xxxx_xxxx_xxxx_xxxx
MAIL_FROM=Bali Telecommunications <no-reply@balitelecommunications.com>
MAIL_TO=sales@balitelecommunications.com

# WhatsApp
WHATSAPP_NUMBER=60123456789

# Frontend URL — used for CORS (no trailing slash)
FRONTEND_URL=https://balitelecommunications.com
